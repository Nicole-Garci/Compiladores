.entrada main
.dados 7
.quadro main 0 []
label rotulo[main]
move temporario[i], constante[0]
move global[6], constante[0]
label rotulo[externo]
lt temporario[cond], temporario[i], constante[2]
if_false temporario[cond], rotulo[fim]
move temporario[j], constante[0]
label rotulo[interno]
lt temporario[cond], temporario[j], constante[3]
if_false temporario[cond], rotulo[proxima_linha]
mul temporario[indice], temporario[i], constante[3]
add temporario[indice], temporario[indice], temporario[j]
addr temporario[p], global[0], temporario[indice]
mul temporario[valor], temporario[i], constante[10]
add temporario[valor], temporario[valor], temporario[j]
store temporario[p], temporario[valor]
load temporario[lido], temporario[p]
add global[6], global[6], temporario[lido]
add temporario[j], temporario[j], constante[1]
goto rotulo[interno]
label rotulo[proxima_linha]
add temporario[i], temporario[i], constante[1]
goto rotulo[externo]
label rotulo[fim]
print global[6]
halt
