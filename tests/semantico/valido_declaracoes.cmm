int total, valores[5];
float media;

int dobro(int x) {
    return x * 2;
}

int soma(int a, int b[4]) {
    int i, resultado;
    resultado = 0;
    i = 0;
    while (i < 4) {
        resultado = resultado + b[i];
        i = i + 1;
    }
    return resultado + a;
}

