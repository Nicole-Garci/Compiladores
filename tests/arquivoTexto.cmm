/* Teste */
typedef struct {
    int codigo;
    float saldo;
    char categoria;
    bool ativo;
} Conta;

int calcular(int a, int b) {
    int resultado;
    resultado = (a + b) * 2 / 1 % 3 - 1;
    return resultado;
}

int main() {
    Conta contas[10];
    int indice;
