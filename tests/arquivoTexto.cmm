    char letra;
    bool valido;
    int x, y;

    x+++++y;
    x++ + ++y;

    indice = 0;
    valor = 12.50;
    letra = 'A';
    valido = true;

    /* O comentario pode ocupar
       mais de uma linha. */
    while (indice < 10 && valido == true) {
        readln(valor);

        if (valor >= 100.0 || valor != 0.0) {
            print("valor valido");
            indice++;
        } else {
            if (valor <= 0.0 && indice > 0) {
                indice--;
            }

            valido = !false;
            break;
        }

        /*erros*/
        float valor@base = 10.5; // O caractere '@' não é reconhecido pelo lexer
        print("valor valido);
